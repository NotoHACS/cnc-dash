@page "/dashboard/{machine?}/history"
@model CncDash.Server.Pages.Dashboard.HistoryModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CNC Shift History</title>
    <link rel="stylesheet" href="/dashboard.css?v=11" />
</head>
<body>
<div class="wrap">
    <div class="topbar">
        <a href="/dashboard/@Model.MachineId">&larr; live dashboard</a>
        <span class="machine">@Model.DisplayName &mdash; shift history</span>
        <span class="right updated"></span>
    </div>

    <div class="card wide">
        <div class="label">Final part counts per shift (parts credited to the shift the batch started)</div>
        <div class="tools-scroll">
            <table class="tools" id="hist">
                <thead>
                    <tr><th>Date</th><th>Shift</th><th>Window</th><th>Part</th><th>Program</th><th>Parts</th></tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="sub" id="hist-empty" style="display:none">No captured shifts yet — rows appear after each shift ends (plus a short grace so a batch that finishes late is still counted).</div>
    </div>
</div>

<script>
(function () {
    // Times arrive PRE-FORMATTED in the machine's local time (server does the
    // conversion). Print them verbatim — never run them through new Date()
    // here, or the browser reinterprets them in the viewer's timezone and
    // every window shifts by your UTC offset.
    fetch("/api/shifthistory/@Model.MachineId?limit=60", { cache: "no-store" })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (rows) {
            var tb = document.querySelector("#hist tbody");
            if (!rows || !rows.length) {
                document.getElementById("hist-empty").style.display = "";
                return;
            }
            tb.innerHTML = rows.map(function (r) {
                // window = first cycle START -> last cycle END (falls back to
                // the shift window if cycle timing wasn't captured)
                var s0 = r.firstCycleStartLocal || r.startLocal || "—";
                var e0 = r.lastCycleEndLocal || r.endLocal || "—";
                return "<tr><td>" + r.localDate + "</td><td>Shift " + r.shift + "</td>" +
                    "<td class=\"muted\">" + s0 + " – " + e0 + "</td>" +
                    "<td>" + (r.partName || "—") + "</td>" +
                    "<td class=\"muted\">" + (r.program || "—") + "</td>" +
                    "<td><b>" + r.parts + "</b></td></tr>";
            }).join("");
        }).catch(function () {
            document.getElementById("hist-empty").style.display = "";
        });
})();
</script>
</body>
</html>