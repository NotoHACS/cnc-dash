@model CncDash.Server.Services.MachineStatus
@using CncDash.Server.Services
@{
    var s = Model;
    var cls = s.Color switch
    {
        StatusColor.Green => "green",
        StatusColor.Yellow => "yellow",
        StatusColor.Red => "red",
        StatusColor.Learning => "learning",
        _ => "off",
    };

    // Shift-start grace: no red/yellow grading before there is anything to grade
    // against — nothing made while the expectation itself is still empty, or the
    // first minutes of a shift. Rendered muted, no colored bar.
    var grace = (s.PartsThisShift == 0 && s.ExpectedParts == 0) || s.ShiftElapsedMinutes < 15;

    string Mmss(double sec)
    {
        var t = TimeSpan.FromSeconds(Math.Max(0, sec));
        return t.TotalMinutes < 60 ? t.ToString(@"mm\:ss") : t.ToString(@"hh\:mm\:ss");
    }

    var orderedTools = s.Tools
        .Select(t => new { T = t, Rank = t.Grade is "warn" or "ng" ? 0 : 1 })
        .OrderBy(x => x.Rank)
        .ThenBy(x => x.T.ToolNumber ?? int.MaxValue)
        .ToList();
    var collapsedCount = orderedTools.Count(x => x.Rank == 1);
    var collapsedNa = orderedTools.Count(x => x.Rank == 1 && x.T.Grade == "na");
    var toggleLabel = collapsedNa > 0 ? $"OK / N-A tools ({collapsedCount})" : $"OK tools ({collapsedCount})";
    var okTogglePending = true;

    // cycle progress percent for the gauge (elapsed / expected, clamped)
    double? cyclePct = null;
    if (s.CurrentCycleSeconds is double ccs && s.LearnedCycleSeconds is double ctarget && ctarget > 0)
        cyclePct = Math.Clamp(ccs / ctarget * 100, 0, 100);
}

<div class="card cyclecard">
    <div class="cc-left">
        <div class="label">Cycle Progress</div>
        @if (s.CurrentCycleSeconds is double cs)
        {
            @if (s.LearnedCycleSeconds is double target && target > 0)
            {
                <div class="big">@Mmss(cs) / @Mmss(target)</div>
            }
            else
            {
                <div class="big">@Mmss(cs)</div>
            }
        }
        else
        {
            <div class="big">&mdash;</div>
            <div class="sub">no cycle data</div>
        }
    </div>
    <div class="cc-gauge">
        <div class="cc-track">
            <div class="cc-fill" style="width:@(cyclePct?.ToString("0") ?? "0")%"></div>
            <div class="cc-pct">@(cyclePct is double cp ? cp.ToString("0") + "%" : "—")</div>
        </div>
    </div>
</div>

<div class="grid">
    <div class="card">
        <div class="label">Parts this shift</div>
        <div class="big">@s.PartsThisShift</div>
        <div class="sub">@s.ExpectedParts expected by now</div>
    </div>
    <div class="card">
        <div class="label">Efficiency</div>
        @if (grace)
        {
            <div class="big muted">on pace</div>
            <div class="sub">building expectation</div>
        }
        else
        {
            <div class="big">@s.PercentOfExpected.ToString("0")%</div>
            <div class="bar"><div class="fill @cls" style="width:@(Math.Min(100, s.PercentOfExpected).ToString("0"))%"></div></div>
        }
    </div>
    @if (s.PercentOfQuota is double quotaPct)
    {
        <div class="card">
            <div class="label">Goal</div>
            <div class="big">@quotaPct.ToString("0")%</div>
            <div class="bar"><div class="fill na" style="width:@Math.Clamp(quotaPct, 0, 100).ToString("0")%"></div></div>
            <div class="sub">@s.PartsThisShift of @s.QuotaParts parts</div>
        </div>
    }
    <div class="card">
        <div class="label">Spindle uptime</div>
        <div class="big">@s.SpindleUptimePercent.ToString("0")%</div>
    </div>
    <div class="card">
        <div class="label">Expired tools</div>
        <div class="big">@s.ExpiredTools</div>
    </div>
    <div class="card machinecard">
        <div class="sbpills">
            <div class="sbpill sbtool">
                <div class="sbpill-label">Current Tool</div>
                <div class="sbpill-value">@(s.CurrentTool?.ToString() ?? "—")</div>
            </div>
            <div class="sbpill sbrpm">
                <div class="sbpill-label">RPM</div>
                <div class="sbpill-value">@(s.LastSpindleSpeed is double rpm ? rpm.ToString("0") : "—")</div>
            </div>
        </div>
        @if (s.Pallet is long pallet)
        {
            <div class="palletline">Pallet @pallet</div>
        }
    </div>
</div>

<div id="alarmbar"></div>
@* ntfy alarm bar: JS below polls the ntfy topic (alarm poller pushes here).
   Red = active alarm (p4), amber = warning/info (p1-2), auto-expires. *@
<script>
(function () {
    var TOPIC_URL = "https://ntfy.fehustn.cc/cnc12/json?poll=1";
    var STALE_SECS = 900;      // p2 info without CLEARED auto-hides after 15min
    var seen = {};             // id -> handled (dedupe)
    var state = {};            // key -> {title, msg, prio, ts, cleared}

    function render() {
        var bar = document.getElementById("alarmbar");
        if (!bar) return;
        var now = Date.now() / 1000;
        var active = [];
        for (var k in state) {
            var a = state[k];
            if (a.cleared) { continue; }
            if (a.prio <= 2 && now - a.ts > STALE_SECS) { continue; }
            active.push(a);
        }
        active.sort(function (a, b) { return b.prio - a.prio; }); // worst first
        if (active.length === 0) { bar.innerHTML = ""; bar.style.display = "none"; return; }
        bar.style.display = "";
        var html = "";
        active.forEach(function (a) {
            var cls = a.prio >= 4 ? "alarmbar red" : "alarmbar amber";
            html += '<div class="' + cls + '" title="' + (a.msg || "").replace(/"/g, "&quot;") + '">' +
                '<span class="ab-title">' + a.title + '</span>' +
                (a.msg && a.msg !== a.title ? '<span class="ab-msg">' + a.msg.split("\n")[0] + '</span>' : '') +
                '</div>';
        });
        bar.innerHTML = html;
    }

    function poll() {
        fetch(TOPIC_URL, { cache: "no-store" }).then(function (r) { return r.text(); }).then(function (t) {
            t.split("\n").forEach(function (line) {
                if (!line.startsWith("{")) return;
                try {
                    var m = JSON.parse(line);
                    if (m.event !== "message" || m.topic !== "cnc12" || seen[m.id]) return;
                    seen[m.id] = 1;
                    var title = m.title || "";
                    var msg = m.message || "";
                    var key, base;
                    var cm = title.match(/^\[CLEARED\]\s*(.+)$/);
                    if (cm) {
                        key = cm[1].trim();           // cleared: key by cleared title text
                        // match with any earlier alarm whose title CONTAINS the key
                        for (var k in state) {
                            if (k.indexOf(key) >= 0 || state[k].title.indexOf(key) >= 0) {
                                state[k].cleared = true;
                            }
                        }
                        state["clr:" + key] = { title: title, msg: msg, prio: 3, ts: m.time, cleared: true };
                        return;
                    } else {
                        key = (title || msg).split("\n")[0].trim();
                        state[key] = { title: title || msg, msg: msg, prio: m.priority || 3, ts: m.time, cleared: false };
                    }
                } catch (e) { /* not json */ }
            });
            render();
        }).catch(function () { });
    }
    poll();
    setInterval(poll, 10000);
})();
</script>

    <div class="card wide">
    <div class="label">Tools</div>
    <div class="tools-scroll">
        <table class="tools">
            <tr><th>Tool</th><th>POT</th><th>Life left</th><th>Cycles left</th><th>Status</th></tr>
            @foreach (var x in orderedTools)
            {
                var t = x.T;
                var isCur = t.ToolNumber != null && s.CurrentTool == t.ToolNumber;
                if (x.Rank == 1 && okTogglePending)
                {
                    okTogglePending = false;
                    <tr id="oktools" class="oktools" onclick="okToggle()"><td colspan="5"><span class="caret"></span>@toggleLabel</td></tr>
                }
                <tr class="@(x.Rank == 1 ? "okrow " : "")@(isCur ? "current" : "")">
                    <td>@(t.ToolNumber?.ToString() ?? "-")</td>
                    <td>@(t.Pot?.ToString() ?? "-")</td>
                    <td>
                        @if (t.PercentRemaining is double pct)
                        {
                            <span>@pct.ToString("0")%</span>
                            <span class="lifebar"><span class="fill @t.Grade" style="width:@Math.Clamp(pct, 0, 100).ToString("0")%"></span></span>
                        }
                        else
                        {
                            <span class="muted">n/a</span>
                        }
                    </td>
                    <td>
                        @if (t.LifeUsedSet is string us)
                        {
                            <span>@us</span>
                        }
                        else
                        {
                            <span class="muted">&mdash;</span>
                        }
                    </td>
                    <td>
                        <span class="chip @t.Grade">@(t.Grade == "na" ? "N/A" : t.Grade.ToUpperInvariant())</span>
                    </td>
                </tr>
            }
        </table>
    </div>
</div>

<script>
    var okOpen = typeof okOpen === "boolean" ? okOpen : false;
    function applyOk() {
        var row = document.getElementById("oktools");
        if (row) row.classList.toggle("open", okOpen);
        document.querySelectorAll(".okrow").forEach(function (r) { r.hidden = !okOpen; });
    }
    function okToggle() {
        okOpen = !okOpen;
        applyOk();
    }
    applyOk();
</script>