@page "/dashboard/admin/login"
@model CncDash.Server.Pages.Admin.LoginModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login — CNC Dashboard</title>
    <link rel="stylesheet" href="/dashboard.css" />
</head>
<body>
<div class="wrap narrow">
    <div class="card wide">
        <div class="label">Sign in</div>
        @if (Model.Failed)
        {
            <div class="reason">Wrong password.</div>
        }
        <form method="post">
            <input type="password" asp-for="Password" placeholder="admin password" autofocus required />
            <button type="submit">Sign in</button>
        </form>
    </div>
</div>
</body>
</html>